#!/bin/sh
# Before a push: run the full test suite, and stop the push if anything fails, so a broken app
# never reaches the live site. Pushes that change no app or test files (notes like CLAUDE.md)
# skip it. Turned on for this repo only: git config core.hooksPath .githooks

zero=0000000000000000000000000000000000000000
empty_tree=$(git hash-object -t tree /dev/null)
changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch: nothing to test
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch on the remote: compare with what it branched from (or everything).
    base=$(git merge-base origin/master "$local_sha" 2>/dev/null || echo "$empty_tree")
  else
    base=$remote_sha
  fi
  changed="$changed$(git diff --name-only "$base" "$local_sha")
"
done

if ! printf '%s' "$changed" | grep -qE '^(app|tests)/'; then
  echo "pre-push: no app or test changes; skipping the test suite."
  exit 0
fi

echo "pre-push: running the full test suite before pushing..."
cd "$(git rev-parse --show-toplevel)/tests" || exit 1
if npm test --silent; then
  exit 0
fi
echo ""
echo "pre-push: tests failed, so the push was stopped. Fix them and push again."
exit 1
